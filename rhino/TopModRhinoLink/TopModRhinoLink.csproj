<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <Version>2.1.2</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TopModRhinoLink</RootNamespace>
    <AssemblyName>TopModRhinoLink</AssemblyName>
    <Title>TopMod 3D for Rhino</Title>
    <Description>TopMod 3D inside Rhino: the modeler runs in a Rhino window, its model lives in Rhino as NURBS, edits flow both ways, with Bake and Import.</Description>
    <Company>AMAXIMAL</Company>
    <Authors>ION / AMAXIMAL</Authors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>NU1701;CS1591</NoWarn>
    <!-- The TopMod app itself is compiled into the plug-in. If the master copy on this Mac is present it is used; otherwise the TOPMOD.html checked in beside this file. -->
    <TopModHtml Condition="Exists('$(HOME)/AMAXiMAL/projects/topmod/TOPMOD.html')">$(HOME)/AMAXiMAL/projects/topmod/TOPMOD.html</TopModHtml>
    <TopModHtml Condition="'$(TopModHtml)'==''">TOPMOD.html</TopModHtml>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(TopModHtml)" LogicalName="TOPMOD.html" />
    <EmbeddedResource Include="bridge.js" LogicalName="bridge.js" />
    <EmbeddedResource Include="topmod.ico" LogicalName="TopModRhinoLink.topmod.ico" />
    <EmbeddedResource Include="TopMod.rhw" LogicalName="TopMod.rhw" Condition="Exists('TopMod.rhw')" />
  </ItemGroup>
  <Target Name="ReportHtml" BeforeTargets="Build">
    <Message Importance="high" Text="Embedding TopMod app from: $(TopModHtml)" />
  </Target>
</Project>
